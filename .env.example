# ---- Opptrix Harness OS configuration (env overrides config/ defaults) ----
# Data directory (SQLite, uploads, extensions db, backups)
HARNESS_DATA_DIR=./data
# HTTP server
HARNESS_PORT=3000
HARNESS_HOST=0.0.0.0
# Trust X-Forwarded-* headers (set 1 ONLY behind a trusted reverse proxy; direct exposure must keep 0)
HARNESS_TRUST_PROXY=0
# Break-glass root token. If empty, generated on first boot and printed once.
HARNESS_TOKEN=
# Auth-less first boot: set to 1 to generate + persist to <data>/root-token (dev convenience)
HARNESS_PERSIST_ROOT_TOKEN=1
# CORS origins (comma separated, * allowed for dev)
HARNESS_CORS_ORIGIN=*
# Logging: trace|debug|info|warn|error
HARNESS_LOG_LEVEL=info
# Timezone for display & default cron schedule (IANA name). Defaults to UTC. Storage is always UTC.
HARNESS_TIMEZONE=UTC
# Task thread pool size
HARNESS_TASK_WORKERS=1
# RPC budgets (ms): kernel<->extension worker calls / extension route handling
HARNESS_RPC_TIMEOUT_MS=30000
HARNESS_ROUTE_TIMEOUT_MS=30000
# Payload limits (bytes): JSON body / file uploads / worker RPC envelope
HARNESS_MAX_BODY_BYTES=2097152
HARNESS_MAX_UPLOAD_BYTES=104857600
HARNESS_MAX_RPC_PAYLOAD_BYTES=8388608
# Per-extension caps: routes in the route table / in-flight route dispatches
HARNESS_MAX_ROUTES_PER_EXT=100
HARNESS_MAX_CONCURRENT_PER_EXT=32
# Crash-loop breaker: sliding window (ms) and max restarts within it before extensions stay disabled
HARNESS_CRASH_LOOP_WINDOW_MS=60000
HARNESS_CRASH_LOOP_MAX=5
# Extension worker entry: auto (dist if built, else dev via tsx) | dist | dev
HARNESS_WORKER_MODE=auto
# Sandbox (Docker code execution). Requires docker socket / DOCKER_HOST.
HARNESS_SANDBOX_ENABLED=0
HARNESS_SANDBOX_IMAGE=opptrix-sandbox:latest
HARNESS_DOCKER_HOST=
# Updater
HARNESS_UPDATE_AUTO=0
HARNESS_UPDATE_FEED=
HARNESS_UPDATE_CHANNEL=stable
HARNESS_UPDATE_TOKEN=
HARNESS_UPDATE_WINDOW=0 4 * * *
