# =============================================================================
# docker/Dockerfile.sandbox — Opptrix Harness OS 代码执行沙箱基础镜像
#
# 用途：内核 sandbox 模块（dockerode）在用户代码执行时以此镜像拉起一次性容器。
# 镜像名与 .env 的 HARNESS_SANDBOX_IMAGE=opptrix-sandbox:latest 对应。
#
# 构建（上下文是 docker/ 目录本身）：
#   docker build -t opptrix-sandbox:latest -f docker/Dockerfile.sandbox docker/
#
# 说明：
# - 选 node:24-bookworm（Debian）而非 alpine：python3/pip 与常见数据类依赖
#   在 glibc 下开箱即用，沙箱内 `pip install` 兜底更顺畅。
# - 基础镜像 pin 到大版本 tag（node:24-bookworm，非 :latest）；如需可复现构建，
#   可进一步替换为 @sha256:<digest> 固定摘要。
# =============================================================================

FROM node:24-bookworm

LABEL org.opencontainers.image.title="opptrix-sandbox" \
      org.opencontainers.image.description="Opptrix Harness OS code-execution sandbox (node24 + python3 + git)" \
      org.opencontainers.image.vendor="Opptrix"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      git \
      ca-certificates \
      curl \
 && rm -rf /var/lib/apt/lists/*

# 非 root 执行用户（uid 1000，与内核 sandbox 的挂载/权限约定对齐）
RUN useradd --create-home --uid 1000 --shell /bin/bash dev

USER dev
WORKDIR /home/dev

# 沙箱容器由内核显式创建/销毁；空闲保活便于调试与 exec
CMD ["sleep", "infinity"]
